# Node.js 24. Copy this file to .env; never commit real keys.
# Only OpenRouter is used. No Gemini Developer API key or Google ADC required.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.1-pro-preview
OPENROUTER_SKIM_MODEL=google/gemini-3.8-flash
OPENROUTER_REVIEW_MODEL=google/gemini-3.1-pro-preview
OPENROUTER_QUESTION_MODEL=anthropic/claude-opus-5

# Paid execution disabled until explicitly set to an approved cumulative USD limit.
# Use the SAME limit and ledger across CLI, web and benchmark. Never reset the ledger.
# Valid paid limit: >0 and <=10. This is not an account-wide billing cap.
PROOFOLIO_MAX_COST_USD=0
PROOFOLIO_BUDGET_LEDGER=output/openrouter-budget.jsonl

# Existing .env.openrouter remains supported; process environment takes precedence,
# then .env, then .env.openrouter. No NEXT_PUBLIC_ secret variables.

# Recruiter dashboard (web "/") uses accounts stored under the store dir (sign up at /login).
# Optional: session signing secret. If unset, one is generated once at <store>/session-secret.
# PROOFOLIO_SESSION_SECRET=
# Optional: where accounts/tests/submissions JSON files live. Default: output/web/store
# PROOFOLIO_STORE_DIR=
