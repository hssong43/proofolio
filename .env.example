# Node.js 24. Copy this file to .env; never commit real keys.
# Only OpenRouter is used. No Gemini Developer API key or Google ADC required.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.1-pro-preview
OPENROUTER_SKIM_MODEL=google/gemini-3.8-flash
OPENROUTER_REVIEW_MODEL=google/gemini-3.1-pro-preview
OPENROUTER_QUESTION_MODEL=anthropic/claude-opus-5

# Paid execution disabled until explicitly set to an approved cumulative USD limit.
# Local CLI/web share the file ledger. Never reset old spending or unknown holds.
# Vercel automatically uses Supabase step execution; its approved window lives in DB.
# Migrations 005/006 alone do NOT fund it. Keep historical ledger/holds in its approval audit.
# Valid paid limit: >0 and <=10. This is not an account-wide billing cap.
PROOFOLIO_MAX_COST_USD=0
PROOFOLIO_BUDGET_LEDGER=output/openrouter-budget.jsonl
# Optional on a local server to exercise the same Vercel execution path.
PROOFOLIO_EXECUTION=

# Contest branch: no signup/login. 0 restores the member/recruiting UI.
PROOFOLIO_CONTEST_MODE=1
# Set 1 and restart to close guest access and expire only contest guest data.
PROOFOLIO_CONTEST_CLOSED=0
# Absolute deadline. This branch defaults to the same date even if omitted.
# Data expires after 24h or this deadline, whichever is earlier.
PROOFOLIO_CONTEST_ENDS_AT=2026-10-20T23:59:59+09:00

# Run migrations 001 -> 002 -> 003 -> 004 -> 005 -> 006 once. Existing data is preserved.
# Member AND guest analysis require supabase. local is only for offline regression checks.
PROOFOLIO_STORAGE=supabase
SUPABASE_URL=
# Server-only sb_secret_... key preferred. Never use NEXT_PUBLIC_ for this key.
SUPABASE_SECRET_KEY=
# Legacy JWT service_role key, only if a secret key is unavailable.
SUPABASE_SERVICE_ROLE_KEY=
# Optional server Auth API key; when omitted, the server key stays server-only.
SUPABASE_PUBLISHABLE_KEY=
# Exact application origin for Auth redirects. No wildcard URLs.
PROOFOLIO_APP_URL=http://127.0.0.1:3100

# Existing .env.openrouter remains supported; process environment takes precedence,
# then .env, then .env.openrouter. No NEXT_PUBLIC_ secret variables.
